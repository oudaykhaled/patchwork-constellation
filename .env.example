# Optional, server-only token to increase GitHub public API quota.
GITHUB_TOKEN=
# Optional GitHub App mode: set ALL five values, otherwise leave ALL blank.
# APP_ORIGIN must match the registered callback origin; HTTPS except HTTP loopback.
# See docs/GITHUB_APP.md. Never put these values in VITE_* variables.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
APP_ORIGIN=
# AI is off by default. Pin evaluated model IDs before enabling.
AI_ENABLED=false
# External AI also requires a reviewed, version-matched live evaluation manifest.
AI_EVALUATION_MANIFEST=
TYPESAFE_API_KEY=
JEV_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional PostgreSQL adapter; see docs/STORAGE.md.
DATABASE_URL=
PORT=4310
